{
  "schema_version": 1,
  "stage": "F2.0.3",
  "status": "reviewed",
  "build_policy": "config/build_policy.json",
  "build_root": "build/targets",
  "configurations": {
    "debug": {"cmake_build_type": "Debug"},
    "release": {"cmake_build_type": "Release"}
  },
  "policy": {
    "shell_execution": false,
    "working_tree_output": "build/targets only",
    "network_during_configure_or_build": false,
    "preflight_before_configure": true,
    "size_gate_after_build": true,
    "required_configurations": ["debug", "release"]
  },
  "targets": [
    {
      "id": "s3",
      "family": "esp_idf",
      "sdk_target": "esp32s3",
      "project_dir": "targets/s3",
      "required_environment": ["IDF_PATH", "IDF_TOOLS_PATH", "IDF_PYTHON_ENV_PATH"],
      "commands": {
        "configure": ["{python}", "{env:IDF_PATH}/tools/idf.py", "-C", "{repo}/targets/s3", "-B", "{build}", "-DIDF_TARGET=esp32s3", "-DSDKCONFIG={build}/sdkconfig", "-DSDKCONFIG_DEFAULTS={repo}/targets/s3/sdkconfig.defaults;{repo}/targets/s3/sdkconfig.{config}", "reconfigure"],
        "build": ["{python}", "{env:IDF_PATH}/tools/idf.py", "-C", "{repo}/targets/s3", "-B", "{build}", "build"],
        "clean": ["{python}", "{env:IDF_PATH}/tools/idf.py", "-C", "{repo}/targets/s3", "-B", "{build}", "fullclean"]
      },
      "artifacts": ["leshy2_s3.bin", "leshy2_s3.elf", "leshy2_s3.map", "bootloader/bootloader.bin", "partition_table/partition-table.bin"],
      "size_gate": {"target": "s3", "image": "leshy2_s3.bin"}
    },
    {
      "id": "c5",
      "family": "esp_idf",
      "sdk_target": "esp32c5",
      "project_dir": "targets/c5",
      "required_environment": ["IDF_PATH", "IDF_TOOLS_PATH", "IDF_PYTHON_ENV_PATH"],
      "commands": {
        "configure": ["{python}", "{env:IDF_PATH}/tools/idf.py", "-C", "{repo}/targets/c5", "-B", "{build}", "-DIDF_TARGET=esp32c5", "-DSDKCONFIG={build}/sdkconfig", "-DSDKCONFIG_DEFAULTS={repo}/targets/c5/sdkconfig.defaults;{repo}/targets/c5/sdkconfig.{config}", "reconfigure"],
        "build": ["{python}", "{env:IDF_PATH}/tools/idf.py", "-C", "{repo}/targets/c5", "-B", "{build}", "build"],
        "clean": ["{python}", "{env:IDF_PATH}/tools/idf.py", "-C", "{repo}/targets/c5", "-B", "{build}", "fullclean"]
      },
      "artifacts": ["leshy2_c5.bin", "leshy2_c5.elf", "leshy2_c5.map", "bootloader/bootloader.bin", "partition_table/partition-table.bin"],
      "size_gate": {"target": "c5", "image": "leshy2_c5.bin"}
    },
    {
      "id": "rp",
      "family": "pico_sdk",
      "sdk_target": "rp2350-arm-s",
      "project_dir": "targets/rp",
      "required_environment": ["PICO_SDK_PATH", "ARM_GNU_TOOLCHAIN_PATH"],
      "commands": {
        "configure": ["cmake", "-S", "{repo}/targets/rp", "-B", "{build}", "-G", "Ninja", "-DCMAKE_BUILD_TYPE={cmake_build_type}", "-DPICO_SDK_PATH={env:PICO_SDK_PATH}", "-DPICO_PLATFORM=rp2350-arm-s", "-DPICO_BOARD=leshy2_rp2354b", "-DPICO_TOOLCHAIN_PATH={env:ARM_GNU_TOOLCHAIN_PATH}"],
        "build": ["cmake", "--build", "{build}", "--parallel"],
        "clean": ["cmake", "--build", "{build}", "--target", "clean"]
      },
      "artifacts": ["leshy2_rp.elf", "leshy2_rp.bin", "leshy2_rp.uf2", "leshy2_rp.map"],
      "size_gate": {"target": "rp2354b", "image": "leshy2_rp.bin"}
    },
    {
      "id": "pack",
      "family": "ti_mspm0_sdk",
      "sdk_target": "MSPM0C1106",
      "project_dir": "targets/pack",
      "required_environment": ["MSPM0_SDK_PATH", "TI_ARM_CLANG_PATH", "SYSCONFIG_PATH"],
      "commands": {
        "configure": ["make", "-C", "{repo}/targets/pack", "CONFIG={config}", "BUILD_DIR={build}", "MSPM0_SDK_PATH={env:MSPM0_SDK_PATH}", "TI_ARM_CLANG_PATH={env:TI_ARM_CLANG_PATH}", "SYSCONFIG_PATH={env:SYSCONFIG_PATH}", "configure"],
        "build": ["make", "-C", "{repo}/targets/pack", "CONFIG={config}", "BUILD_DIR={build}", "MSPM0_SDK_PATH={env:MSPM0_SDK_PATH}", "TI_ARM_CLANG_PATH={env:TI_ARM_CLANG_PATH}", "SYSCONFIG_PATH={env:SYSCONFIG_PATH}", "all"],
        "clean": ["make", "-C", "{repo}/targets/pack", "CONFIG={config}", "BUILD_DIR={build}", "clean"]
      },
      "artifacts": ["leshy2_pack_boot.out", "leshy2_pack_boot.bin", "leshy2_pack_boot.map", "leshy2_pack.out", "leshy2_pack.bin", "leshy2_pack.map"],
      "size_gate": {"target": "pack", "image": "leshy2_pack.bin"}
    },
    {
      "id": "safety",
      "family": "ti_mspm0_sdk",
      "sdk_target": "MSPM0C1106",
      "project_dir": "targets/safety",
      "required_environment": ["MSPM0_SDK_PATH", "TI_ARM_CLANG_PATH", "SYSCONFIG_PATH"],
      "commands": {
        "configure": ["make", "-C", "{repo}/targets/safety", "CONFIG={config}", "BUILD_DIR={build}", "MSPM0_SDK_PATH={env:MSPM0_SDK_PATH}", "TI_ARM_CLANG_PATH={env:TI_ARM_CLANG_PATH}", "SYSCONFIG_PATH={env:SYSCONFIG_PATH}", "configure"],
        "build": ["make", "-C", "{repo}/targets/safety", "CONFIG={config}", "BUILD_DIR={build}", "MSPM0_SDK_PATH={env:MSPM0_SDK_PATH}", "TI_ARM_CLANG_PATH={env:TI_ARM_CLANG_PATH}", "SYSCONFIG_PATH={env:SYSCONFIG_PATH}", "all"],
        "clean": ["make", "-C", "{repo}/targets/safety", "CONFIG={config}", "BUILD_DIR={build}", "clean"]
      },
      "artifacts": ["leshy2_safety_boot.out", "leshy2_safety_boot.bin", "leshy2_safety_boot.map", "leshy2_safety.out", "leshy2_safety.bin", "leshy2_safety.map"],
      "size_gate": {"target": "safety", "image": "leshy2_safety.bin"}
    }
  ]
}

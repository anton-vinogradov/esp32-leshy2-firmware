# C5 production identity and memory contract. The partition path is relative to
# this ESP-IDF project; config/sdkconfig.defaults.esp32c5 remains the canonical
# product-level source checked by the public memory contract.
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="../../config/partitions_8m_c5.csv"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
